# =============================================================
# ResumeIQ Environment Variables — copy to .env and fill values
# =============================================================

# --- Server ---
NODE_ENV=development
PORT=3001

# MongoDB connection string (kept during migration transition — remove after full cutover)
MONGODB_URI=mongodb://localhost:27017/resumeiq

# PostgreSQL connection string (required for SQL persistence)
# Local:  postgresql://postgres:password@localhost:5432/resumeiq
# Docker: postgresql://postgres:password@postgres:5432/resumeiq
# Atlas / Supabase: postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/resumeiq   # <-- change for your setup

# JWT secrets — generate strong random values, at least 64 chars each
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars_long_xxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars_long_xxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set to your frontend URL in production
CLIENT_URL=http://localhost:5173

# --- AI Providers (at least one for real AI; omit all for demo mode) ---
# Anthropic (preferred)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3-compatible (set STORAGE_PROVIDER=s3 to use)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=             # for non-AWS S3-compatible services

# --- Email (optional) ---
EMAIL_PROVIDER=console       # console | smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@resumeiq.example.com

# --- Auth bypass (testing / demo only) ---
# Set to true to skip login — a demo admin user is auto-created and all
# visitors are automatically signed in as that user. Never use in production.
# DISABLE_AUTH=true   # uncomment to skip login (auto-logs in as demo user)

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000   # 15 min
RATE_LIMIT_MAX_REQUESTS=100

# --- Client (Vite prefix required for frontend env vars) ---
VITE_API_URL=/api/v1
